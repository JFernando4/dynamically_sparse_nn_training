{
  "file_management": {
    "experiment_name": "tanh_large_humanoid_policy_collapse",
    "results_path": "/scratch/jfernan/dynamically_sparse_nn_training/results/",
    "relevant_parameters": [
      "weight_decay",
      "reinit_freq",
      "drop_factor",
      "prune_method",
      "grow_method"
    ]
  },

  "experiment_params": {
    "env_name": "Humanoid-v5",
    "total_env_steps": 20000000,
    "activation_type": "Tanh",
    "hidden_dim": 64,
    "adam_beta1": 0.99,
    "adam_beta2": 0.99,
    "buffer_size": 2048,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "num_epochs": 10,
    "n_slices": 16,
    "u_adv_scl": true,
    "clip_eps": 0.2,
    "runs": 5
  },

  "learning_params": {
    "stepsize": ["fixed", 0.0003],
    "use_ln": true,
    "weight_decay": 0.0,
    "reinit_freq": ["fixed", 256, 512, 1024, 2048],
    "drop_factor": ["fixed", 1e-3, 1e-4, 1e-5],
    "prune_method": ["str", "gr"],
    "grow_method": ["str", "init"]
  },

  "slurm_parameters": {
    "job_name": "thuman",
    "time": "12:00:00",
    "max_runs_per_job": 1,
    "mem": "4G",
    "cpus-per-task": 1,
    "load_modules": [
      "module load mujoco/3.1.6\n"
    ]
  }
}