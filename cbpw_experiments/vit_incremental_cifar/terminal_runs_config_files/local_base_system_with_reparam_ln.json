{
  "file_management": {
    "experiment_name": "reparam_ln_vit_cifar",
    "data_path": "./cbpw_experiments/vit_incremental_cifar/data/",
    "results_path": "./cbpw_experiments/vit_incremental_cifar/results/",
    "relevant_parameters":
    [
      "num_epochs",
      "stepsize",
      "weight_decay",
      "rescaled_wd",
      "shifted_ln"
    ]
  },

  "experiment_params": {
    "stepsize": 0.01,
    "dropout_prob": 0.1,
    "use_lr_schedule": true,
    "rescaled_wd": true,
    "shifted_ln": true,
    "momentum": 0.9,
    "num_epochs": 100,
    "initial_num_classes": 100,
    "fixed_classes": true,
    "gpu_index": 1,
    "runs": 5
  },

  "learning_params": {
    "weight_decay": ["fixed", 1e-2, 5e-3, 3e-3, 2e-3, 1e-3, 9e-4, 8e-4, 5e-4, 1e-4]
  }

}